{
  "name": "emp-mgmt-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./dist/trpc/router.d.ts"
    }
  },
  "scripts": {
    "predev": "pnpm --filter @emp-mgmt/shared build",
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "prebuild": "pnpm --filter @emp-mgmt/shared build",
    "build": "tsc",
    "prestart": "pnpm --filter @emp-mgmt/shared build",
    "start": "node --env-file=.env dist/index.js",
    "pretypecheck": "pnpm --filter @emp-mgmt/shared build",
    "typecheck": "tsc --noEmit",
    "test:http": "node scripts/onboarding-http-smoke.mjs"
  },
  "dependencies": {
    "@emp-mgmt/shared": "workspace:*",
    "@trpc/server": "^11",
    "bcrypt": "^6.0.0",
    "express": "^4",
    "express-session": "^1",
    "mongoose": "^8",
    "multer": "^2",
    "nodemailer": "^9.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/express-session": "^1",
    "@types/multer": "^1",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/qs": "^6.14.0",
    "tsx": "^4",
    "typescript": "^6.0.3"
  }
}
