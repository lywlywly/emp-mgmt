PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/emp_mgmt
SESSION_SECRET=change-me-in-prod

# Frontend base URL used to build the registration link (Phase 3).
FRONTEND_URL=http://localhost:5173

# Email sending mode: "console" (default, just logs) or "smtp" (really sends).
EMAIL_MODE=console

# Only needed when EMAIL_MODE=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
